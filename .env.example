# Copy to .env and adjust. Env vars override values in .env.
# Test users are registered per run, so no credentials are needed to run tests.
# Optional: admin login used to delete the test user after the run (cleanup is skipped if unset).
# ADMIN_EMAIL=admin@practicesoftwaretesting.com
# ADMIN_PASSWORD=welcome01
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com
API_TIMEOUT=10
